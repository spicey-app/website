---
export interface Props {
  title?: string;
  description?: string;
  source?: string;
}
const {
  title = 'Get restaurant growth tips in your inbox',
  description = 'One short email per week. No spam, unsubscribe anytime.',
  source = 'website',
} = Astro.props;

const endpoint = import.meta.env.PUBLIC_NEWSLETTER_ENDPOINT;
---
<aside class="newsletter" data-newsletter data-endpoint={endpoint} data-source={source}>
  <h3>{title}</h3>
  <p>{description}</p>
  <form class="newsletter__form" novalidate>
    <input
      type="email"
      name="email"
      required
      autocomplete="email"
      placeholder="you@yourrestaurant.com"
      aria-label="Email address"
    />
    {/* honeypot — bots fill this; humans don't see it */}
    <input
      type="text"
      name="company"
      tabindex="-1"
      autocomplete="off"
      aria-hidden="true"
      style="position:absolute;left:-10000px;width:1px;height:1px;opacity:0;"
    />
    <button type="submit" class="btn btn--primary">Subscribe</button>
  </form>
  <p class="newsletter__status" role="status" aria-live="polite" hidden></p>
</aside>

<script>
  type Status = 'idle' | 'loading' | 'success' | 'error';

  function setStatus(el: HTMLElement, status: Status, message = '') {
    el.dataset.status = status;
    if (!message) {
      el.hidden = true;
      el.textContent = '';
      return;
    }
    el.hidden = false;
    el.textContent = message;
    el.style.color =
      status === 'success' ? '#1d7a3a' :
      status === 'error' ? '#c8472a' :
      'var(--ink-soft)';
  }

  document.querySelectorAll<HTMLElement>('[data-newsletter]').forEach((root) => {
    const form = root.querySelector<HTMLFormElement>('form.newsletter__form');
    const status = root.querySelector<HTMLElement>('.newsletter__status');
    const endpoint = root.dataset.endpoint;
    const source = root.dataset.source ?? 'website';
    if (!form || !status) return;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const email = String(data.get('email') ?? '').trim();
      const honeypot = String(data.get('company') ?? '');

      if (honeypot) {
        // Pretend success for bots, do nothing.
        setStatus(status, 'success', 'Thanks! Check your inbox to confirm. 🎉');
        form.reset();
        return;
      }
      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        setStatus(status, 'error', 'Please enter a valid email address.');
        return;
      }
      if (!endpoint) {
        setStatus(status, 'error', 'Newsletter not configured yet. Try again soon.');
        return;
      }

      setStatus(status, 'loading', 'Subscribing…');
      const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (submitBtn) submitBtn.disabled = true;

      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ email, source }),
        });
        if (res.ok) {
          let body: any = {};
          try { body = await res.json(); } catch {}
          const message = body.alreadySubscribed
            ? "You're already on the list — thanks! 🎉"
            : 'Thanks! Check your inbox to confirm. 🎉';
          setStatus(status, 'success', message);
          form.reset();
          // PostHog event (if loaded)
          (window as any).posthog?.capture?.('newsletter_subscribed', { source });
        } else {
          let body: any = {};
          try { body = await res.json(); } catch {}
          setStatus(
            status,
            'error',
            body.error || 'Something went wrong. Please try again in a moment.'
          );
        }
      } catch {
        setStatus(status, 'error', 'Network error. Please try again.');
      } finally {
        if (submitBtn) submitBtn.disabled = false;
      }
    });
  });
</script>
