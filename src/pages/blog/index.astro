---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const dateFmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---
<BaseLayout
  title="Blog — Spicey"
  description="Tips, stories, and insights to help your restaurant grow online — from the team at Spicey."
>
  <section class="section">
    <div class="container">
      <h2>The Spicey blog</h2>
      <p class="section__lead">Tips, stories, and insights to help your restaurant thrive online.</p>
      <div class="grid grid--3">
        {posts.map((post) => (
          <article class="post">
            <a href={`/blog/${post.slug}`} style="display: contents;">
              <div class="post__thumb" style={`background: ${post.data.heroGradient ?? 'linear-gradient(135deg, #ffd9c2, #ffb38a)'};`}>
                {post.data.heroEmoji ?? '📝'}
              </div>
              <div class="post__body">
                <span class="post__meta">
                  {dateFmt(post.data.pubDate)} · {post.data.readTime ?? '5 min read'}
                </span>
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
                <span class="post__link">Read more →</span>
              </div>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
